EXPO_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY=your_apple_api_key_here
EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=your_google_api_key_here

# Secretul webhook-ului RevenueCat este citit server-side (Edge Function
# revenuecat-webhook) din dashboard-ul Supabase; nu pune valoarea reală în .env.
REVENUECAT_WEBHOOK_AUTH_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
