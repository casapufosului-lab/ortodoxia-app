# ══════════════════════════════════════════════════════════════════════════════
# CLIENT-SAFE VARIABLES (EXPO_PUBLIC_*)
# Aceste variabile sunt expuse în bundle-ul JS și pot fi citite de oricine.
# Folosește EXPO_PUBLIC_* doar pentru chei care sunt în siguranță să fie
# publice (publishable keys, API keys de client).
# ══════════════════════════════════════════════════════════════════════════════

EXPO_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY=your_apple_api_key_here
EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=your_google_api_key_here

# ══════════════════════════════════════════════════════════════════════════════
# SERVER-SIDE SECRETS — SUPABASE EDGE FUNCTIONS
# Aceste variabile sunt citite DOAR server-side (Edge Functions Deno).
# NICIODATĂ cu prefixul EXPO_PUBLIC_ — sunt excluse din bundle-ul JS.
# Se setează în Supabase Dashboard → Edge Functions → Secrets.
# ══════════════════════════════════════════════════════════════════════════════

# Folosit de TOATE Edge Functions:
# - send-daily-notifications
# - revenuecat-webhook
# - orthodox-chat
# - live-services-status
# - generate-prayer-audio
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY

# revenuecat-webhook: autorizarea semnăturii webhook-ului
REVENUECAT_WEBHOOK_AUTH_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
REVENUECAT_API_KEY=REPLACE_WITH_REVENUECAT_SECRET_API_KEY

# orthodox-chat + generate-prayer-audio: API key pentru OpenAI
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY

# live-services-status: YouTube Data API v3 (server-side, nu expus în client)
YOUTUBE_DATA_API_KEY=REPLACE_WITH_YOUTUBE_DATA_API_KEY

# send-daily-notifications: secret partajat pentru autorizarea apelurilor cron
NOTIFICATION_CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# generate-prayer-audio: token pentru autorizarea generării de audio
PRAYER_AUDIO_GENERATION_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
