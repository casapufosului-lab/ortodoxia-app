{
  "expo": {
    "name": "Ortodoxia",
    "slug": "ortodoxia",
    "description": "Ghid creștin-ortodox: calendar, rugăciuni, mesajul zilei, slujbe live și chat AI.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ortodoxia",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "ro.ortodoxia.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Permite aplicației Ortodoxia să transforme vocea dictată în text.",
        "NSMicrophoneUsageDescription": "Permite aplicației Ortodoxia să folosească microfonul pentru dictarea întrebărilor."
      }
    },
    "android": {
      "package": "ro.ortodoxia.app",
      "versionCode": 3,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/with-android-hardening",
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#1663A4"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Permite aplicației Ortodoxia să folosească Face ID pentru a-ți proteja sesiunea de autentificare."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permite aplicației Ortodoxia să folosească microfonul pentru dictarea întrebărilor.",
          "speechRecognitionPermission": "Permite aplicației Ortodoxia să transforme vocea dictată în text.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts",
            "com.google.android.as"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ef0641df-1df2-4fe9-ab01-60f61528d3fe"
      }
    },
    "owner": "ortodoxia"
  }
}
