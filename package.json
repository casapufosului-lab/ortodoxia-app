{
  "name": "ortodoxia-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.14",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@supabase/supabase-js": "^2.112.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "expo": "~57.0.18",
    "expo-audio": "~57.0.4",
    "expo-constants": "~57.0.16",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.2",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.8",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-screen-orientation": "~57.0.2",
    "expo-secure-store": "~57.0.2",
    "expo-speech": "~57.0.2",
    "expo-speech-recognition": "^57.0.0",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-purchases": "^10.8.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "^13.13.5",
    "react-native-worklets": "0.10.1",
    "react-native-youtube-iframe": "^2.4.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/three": "^0.186.0",
    "expo-dev-client": "~57.0.18",
    "three": "^0.186.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit --pretty false",
    "typecheck:edge": "tsc --project tsconfig.edge.json --pretty false",
    "typecheck:all": "npm run typecheck && npm run typecheck:edge",
    "test": "node scripts/run-tests.mjs",
    "test:i18n": "node scripts/validate-i18n-corpus.mjs && node scripts/normalize-legal-placeholders.mjs",
    "test:a11y": "node scripts/accessibility-audit.mjs",
    "test:startup": "node scripts/startup-budget.mjs",
    "test:release": "node scripts/release-readiness.mjs",
    "verify": "npm run typecheck:all && npm run test:i18n && npm run test:a11y && npm run test:safety && npm run test:startup && npm test && npm run test:release",
    "test:live": "node --test tests/live-services.test.mjs",
    "test:live-backend": "node --experimental-strip-types --test supabase/functions/live-services-status/tests/live-status.test.mjs supabase/functions/live-services-status/tests/drift.test.mjs supabase/functions/live-services-status/tests/aud2-live-validation.test.mjs",
    "test:notifications": "node --test tests/notifications.test.mjs",
    "test:account-deletion": "node --test tests/account-deletion.test.mjs",
    "test:chat-backend": "node --test tests/chat-backend.test.mjs",
    "db:drift": "node scripts/schema-drift.mjs",
    "content:export": "node scripts/bible-corpus-export.mjs",
    "content:export:check": "node scripts/bible-corpus-export.mjs --check",
    "lint:chat-backend": "node scripts/lint-chat-backend.cjs",
    "test:safety": "node scripts/safety-gate.mjs"
  },
  "private": true
}
